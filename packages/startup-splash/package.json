{
  "name": "@local/dsh-startup-splash",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Full-viewport startup loading animation for the DeepSeek Harness Web UI: warp starfield, aurora fields, energy core and HUD.",
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "startup",
    "splash",
    "animation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wk-single/my-plugins.git",
    "directory": "packages/startup-splash"
  },
  "homepage": "https://github.com/wk-single/my-plugins/tree/main/packages/startup-splash",
  "bugs": {
    "url": "https://github.com/wk-single/my-plugins/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
